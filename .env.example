# Copy to .env and fill in. .env is gitignored and is loaded only by the orchestrator,
# outside any sandbox; it is never mounted into a container.
# Each agent receives only the LLM key for its own harness.

# Required. The database password: any string. Only the MCP service sees it, no agent.
NEO4J_PASSWORD=change-me

# Only if a codex-harness agent should use a key instead of the machine's `codex login`
# session (~/.codex). Leave unset to use the login session.
#OPENAI_API_KEY=sk-...

# Only if a claude-harness agent should use a key instead of the machine's `claude login`
# session (~/.claude). Leave unset to use the login session.
#ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown). See agentdiscover/config.py for the full list.
#NEO4J_PORT=7687
#AGENTDISCOVER_PORT=8900
#SANDBOX_BACKEND=docker|podman|apptainer|singularity|enroot|none
#AGENTDISCOVER_IMAGE=ghcr.io/mhdfb/agentdiscover:latest
